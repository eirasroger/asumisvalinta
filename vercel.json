{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/",
      "framework": "nextjs"
    },
    "api": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "asumisvalinta.api.app:app",
      "buildCommand": "python scripts/vercel_build.py",
      "functions": {
        "src/asumisvalinta/api/app.py": {
          "maxDuration": 120,
          "excludeFiles": "{web/**,tests/**,fixtures/**,evals/**,docs/**,.github/**,data/**,dist/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
