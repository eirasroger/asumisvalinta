{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "services": {
    "web": {
      "root": "web/",
      "framework": "nextjs"
    },
    "api": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "buildCommand": "python scripts/vercel_build.py",
      "functions": {
        "main.py": {
          "maxDuration": 120,
          "excludeFiles": "{web/**,tests/**,fixtures/**,evals/**,docs/**,.github/**,data/**,dist/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
