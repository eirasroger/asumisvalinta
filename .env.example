# Path of the DuckDB warehouse file (default: data/asumisvalinta.duckdb)
ASUMISVALINTA_DUCKDB_PATH=data/asumisvalinta.duckdb

# Language model for the agents. Any provider with an OpenAI-compatible Chat Completions API works.
ASUMISVALINTA_LLM_BASE_URL=https://api.openai.com/v1
ASUMISVALINTA_LLM_MODEL=gpt-5.4-mini-2026-03-17
ASUMISVALINTA_LLM_API_KEY=
# Optional: reasoning effort sent with each request (for example none or low)
ASUMISVALINTA_LLM_REASONING_EFFORT=

# Optional: store Worker URL and secret, or sqlite:///path, for limits and usage events
ASUMISVALINTA_STORE_URL=
ASUMISVALINTA_STORE_SECRET=

# Optional limits, shown with their defaults
# ASUMISVALINTA_LLM_DAILY_TOKEN_LIMIT=2000000
# ASUMISVALINTA_ASK_SESSION_LIMIT=10
# ASUMISVALINTA_EVENTS_DAILY_LIMIT=20000

# Optional: comma-separated sites whose pages may call the API
# ASUMISVALINTA_ALLOWED_ORIGINS=https://asumisvalinta.fi,https://www.asumisvalinta.fi,http://localhost:3000,http://127.0.0.1:3000
