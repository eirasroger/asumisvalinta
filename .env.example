# Path of the DuckDB warehouse file (default: data/asumisvalinta.duckdb)
ASUMISVALINTA_DUCKDB_PATH=data/asumisvalinta.duckdb

# Language model for the agents. Any provider with an OpenAI-compatible Chat Completions API works.
ASUMISVALINTA_LLM_BASE_URL=https://api.openai.com/v1
ASUMISVALINTA_LLM_MODEL=gpt-5.4-mini-2026-03-17
ASUMISVALINTA_LLM_API_KEY=
# Optional: reasoning effort sent with each request (for example none or low)
ASUMISVALINTA_LLM_REASONING_EFFORT=

# Optional: Postgres database for anonymous usage events (Vercel's Neon integration sets DATABASE_URL)
ASUMISVALINTA_ANALYTICS_DATABASE_URL=
# Optional: most usage events stored per UTC day (default 20000)
ASUMISVALINTA_EVENTS_DAILY_LIMIT=
